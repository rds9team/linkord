# Server Settings
APP_ENV=production
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
FRONTEND_URL=https://linkord.net
API_URL=https://api.linkord.net

# Database
DATABASE_URL=sqlite+aiosqlite:///./linkord.db

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.linkord.net/api/auth/discord/callback

# Support Link (PayPay)
PAYPAY_SUPPORT_URL=https://linkord.net

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Admin Accounts
# 管理者のアカウントID（カンマ区切り）。Founder / Team バッジ保持者も管理者として扱われます
ADMIN_ACCOUNT_IDS=

# 転送ヘッダー（X-Forwarded-For 等）を信頼するプロキシのIP
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Pages Functions の API プロキシと共有するシークレット（Pages 側の環境変数 PROXY_SHARED_SECRET と同じ値）
PROXY_SHARED_SECRET=
